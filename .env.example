# =============================================================================
# SupplyChainXAI — environment template.
# Copy to `.env` (git-ignored) and fill in ONLY what you need.
# Every variable is optional; the system runs with zero configuration.
# NEVER commit real credentials.
# =============================================================================

# ---- LLM-backed copilot (optional; any OpenAI-compatible endpoint) ----------
# Without a key the copilot runs in grounded-narrator mode: same retrieval,
# same numbers, deterministic wording. Tests never require a key.
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# SCX_LLM_MODEL=gpt-4o-mini

# ---- Database (default: SQLite at data/processed/analytics.db) -------------
# SQLite:
# DATABASE_URL=sqlite:///data/processed/analytics.db
# PostgreSQL (production-like; used by docker-compose):
# DATABASE_URL=postgresql://scx:scx_dev_password@localhost:5432/scx

# ---- MLflow experiment tracking (optional; JSON-lines fallback by default) --
# Local file store (default when mlflow is installed):
# MLFLOW_TRACKING_URI=file:///absolute/path/to/mlruns
# MLflow server (docker compose --profile mlflow):
# MLFLOW_TRACKING_URI=http://localhost:5000
# SCX_MLFLOW_EXPERIMENT=supplychainxai

# ---- Environment label (shows up in tags/logs) ------------------------------
# SCX_ENVIRONMENT=development

# ---- Walk-forward evaluation (see supplychainxai/config/settings.py) --------
# SCX_EVAL__HORIZON=30
# SCX_EVAL__FOLDS=4
# SCX_EVAL__MIN_TRAIN_DAYS=365
# SCX_EVAL__STRIDE=0
# SCX_EVAL__SELECTION_METRIC=composite     # WAPE | MAE | RMSE | composite
# SCX_EVAL__W_WAPE=0.50
# SCX_EVAL__W_MAE=0.30
# SCX_EVAL__W_RMSE=0.20
# SCX_RANDOM_SEED=42

# ---- Monitoring thresholds --------------------------------------------------
# SCX_MON__WAPE_WARN=20.0
# SCX_MON__WAPE_CRIT=28.0
# SCX_MON__WAPE_DEGRADE_PCT=25.0
# SCX_MON__PSI_WARN=0.10
# SCX_MON__PSI_CRIT=0.25
# SCX_MON__KS_ALPHA=0.05
# SCX_MON__COVERAGE_TARGET=0.80
# SCX_MON__COVERAGE_MIN=0.70
# SCX_MON__STALE_DAYS=7

# ---- Retraining policy / promotion gates ------------------------------------
# SCX_RETRAIN__WAPE_TOLERANCE=0.05
# SCX_RETRAIN__MAX_AGE_DAYS=90
# SCX_RETRAIN__NEW_DATA_ROWS=0
# SCX_RETRAIN__REQUIRE_NO_DQ_ERRORS=true

# ---- docker-compose only ----------------------------------------------------
# POSTGRES_PASSWORD=scx_dev_password
